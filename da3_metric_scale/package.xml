<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>da3_metric_scale</name>
  <version>0.1.0</version>
  <description>Metric scale for Depth Anything 3 (ROS 2 Jazzy..Lyrical) depth from OptiTrack poses (floor plane + triangulation), OptiTrack -> MAVROS vision pose for ArduPilot, nvblox ESDF, Fast-Planner (kinodynamic A* + NLopt B-spline) and a GUIDED trajectory tracker.</description>
  <maintainer email="dilon.hew@gmail.com">Dilon</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>mavros_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>nvblox_msgs</depend>
  <depend>libnlopt-cxx-dev</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>nvblox_ros</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>vrpn_mocap</exec_depend>
  <exec_depend>depth_anything_3_ros2</exec_depend>
  <exec_depend>usb_cam</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
