<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>da3_metric_scale</name>
  <version>0.1.0</version>
  <description>Metric scale for Depth Anything 3 (ROS 2 Jazzy..Lyrical) depth from OptiTrack poses (floor plane + triangulation), and OptiTrack -> MAVROS vision pose for ArduPilot.</description>
  <maintainer email="dilon.hew@gmail.com">Dilon</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>mavros_msgs</depend>
  <depend>geographic_msgs</depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>vrpn_mocap</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
